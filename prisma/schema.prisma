generator markdown {
  provider = "prisma-markdown"
  output   = "./ERD.md"
  title    = "My Database Schema"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  employees   Employee[]
  // DDs of other departments who also look after this department (additional charge)
  chargeHolders DepartmentCharge[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// A DD who also holds additional charge of another department.
/// Leave requests of that department can then be decided by this DD as well.
model DepartmentCharge {
  id           String   @id @default(cuid())
  employeeId   String
  departmentId String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([employeeId, departmentId])
  @@index([departmentId])
}

model Designation {
  id            String        @id @default(cuid())
  title         String        @unique
  approvalLevel ApprovalLevel @default(STAFF)
  employees     Employee[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Employee {
  id           String    @id @default(cuid())
  employeeCode String    @unique
  biometricId  String?   @unique
  name         String
  email        String    @unique
  phoneNumber  String?
  joiningDate  DateTime?
  isActive     Boolean   @default(true)

  departmentId  String
  designationId String?
  //relationship
  department    Department   @relation(fields: [departmentId], references: [id])
  designation   Designation? @relation(fields: [designationId], references: [id])

  attendance    Attendance[]
  importedRows  ImportedAttendanceRow[]
  leaveRequests LeaveRequest[]
  shortLeaves   ShortLeave[]
  additionalCharges DepartmentCharge[]
  user          User?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([departmentId])
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @db.Date

  checkIn  DateTime?
  checkOut DateTime?

  workingMinutes    Int @default(0)
  lateMinutes       Int @default(0)
  earlyLeaveMinutes Int @default(0)
  overtimeMinutes   Int @default(0)

  status        AttendanceStatus @default(INCOMPLETE)
  remarks       String?
  punches       String?
  sourceBatchId String?
  isManual      Boolean          @default(false)
  editedById    String?
  editedAt      DateTime?
  editReason    String?

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date]) //This ensures that an employee can have only one attendance record per date.
  @@index([date]) //This creates a database index on the date column.
  @@index([employeeId, date]) //This creates a composite index using two columns: employeeId and date.
}

model AttendanceSettings {
  id                           String   @id @default("default")
  shiftStart                   String   @default("08:00")
  shiftEnd                     String   @default("16:00")
  graceMinutes                 Int      @default(15) // this is 15minutes for grace period. 
  halfDayAfterMinutes          Int      @default(180)
  duplicatePunchMinutes        Int      @default(15)
  earliestPunch                String   @default("07:00")
  latestPunch                  String   @default("22:00")
  overtimeMinMinutes           Int      @default(0)
  offDayWorkIsOvertime         Boolean  @default(false)
  defaultWeeklyOffDays         Int[]    @default([5, 6, 0])
  shortLeaveMaxMinutes         Int      @default(180)
  shortLeaveMonthlyLimit       Int      @default(0)
  shortLeaveExcusesLateArrival Boolean  @default(true)
  updatedById                  String?
  updatedAt                    DateTime @updatedAt
}

model MonthlyOffDays {
  id            String   @id @default(cuid())
  year          Int
  month         Int
  weeklyOffDays Int[]
  updatedAt     DateTime @updatedAt

  @@unique([year, month])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  title     String
  createdAt DateTime @default(now())
}

model DevicePunch {
  id           String   @id @default(cuid())
  deviceId     String
  deviceUserId String
  punchedAt    DateTime
  punchState   Int?
  verifyMode   Int?
  sourceKey    String   @unique
  rawData      Json
  importedAt   DateTime @default(now())

  @@index([deviceId, punchedAt])
  @@index([deviceUserId, punchedAt])
}

model ImportBatch {
  id       String       @id @default(cuid())
  fileName String
  fileHash String?
  month    Int
  year     Int
  status   ImportStatus @default(UPLOADED)

  totalRows      Int       @default(0)
  successfulRows Int       @default(0)
  failedRows     Int       @default(0)
  processedAt    DateTime?
  uploadedById   String?
  uploadedBy     User?     @relation(fields: [uploadedById], references: [id])

  importedRows ImportedAttendanceRow[]
  errors       ImportError[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileHash])
  @@index([year, month])
}

model ImportedAttendanceRow {
  id            String  @id @default(cuid())
  importBatchId String
  employeeId    String?

  sourceRowNumber Int
  rawData         Json

  attendanceDate     DateTime?   @db.Date
  sourceClockIn      String?
  sourceClockOut     String?
  sourceAbsent       Boolean?
  sourceWorkTime     String?
  sourceAttTime      String?
  sourcePunches      String?
  sourceBiometricId  String?
  sourceEmployeeName String?
  importBatch        ImportBatch @relation(fields: [importBatchId], references: [id])
  employee           Employee?   @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([importBatchId, sourceRowNumber])
  @@index([employeeId, attendanceDate])
}

model ImportError {
  id            String  @id @default(cuid())
  importBatchId String
  rowNumber     Int?
  columnName    String?
  message       String

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])
  createdAt   DateTime    @default(now())
}

model LeaveType {
  id              String         @id @default(cuid())
  name            String         @unique
  isPaid          Boolean        @default(true)
  yearlyQuotaDays Int?
  isActive        Boolean        @default(true)
  leaveRequests   LeaveRequest[]
}

model LeaveRequest {
  id          String             @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  reason      String?
  status      LeaveRequestStatus @default(PENDING)
  days        Int                @default(0)

  decidedById String?
  decidedAt   DateTime?

  // Approval routing, fixed when the request is created.
  approverLevel        ApprovalLevel?
  approverDepartmentId String? // set when approverLevel is DD: only a DD of this department may decide
  routeNote            String? // e.g. "No DD in department, sent to CEO"
  requestedById        String?

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, startDate, endDate])
}

enum ApprovalLevel {
  STAFF
  DD
  CEO
  CHAIRMAN
}

model ShortLeave {
  id              String             @id @default(cuid())
  employeeId      String
  date            DateTime           @db.Date
  startTime       DateTime?
  endTime         DateTime?
  durationMinutes Int                @default(0)
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  decidedById     String?
  decidedAt       DateTime?
  employee        Employee           @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, date])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                  String    @id @default(cuid())
  fullName            String
  email               String    @unique
  passwordHash        String
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  roleId     String
  employeeId String? @unique

  role     Role      @relation(fields: [roleId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  importBatches ImportBatch[]
}

////////////////////////////enums////////////////////////////
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
  INCOMPLETE
  SHORT_LEAVE
}

enum ImportStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  COMPLETED_WITH_ERRORS
}
